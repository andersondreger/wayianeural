# Copie para .env na VPS (chmod 600). Nunca commitar o .env real.
# Chave global da Evolution (evo2.wayiaflow.com.br) - usada so pelo proxy nginx /evo/
EVOLUTION_API_KEY=
# Chave publishable do Supabase (a mesma de lib/supabase.ts) - valida a sessao no proxy
SUPABASE_PUBLISHABLE_KEY=

# --- payments-api (admin de pagamentos) ---
# service_role do Supabase: so no servidor, ignora RLS. Nunca no navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Asaas: comece no sandbox (https://sandbox.asaas.com/api/v3); producao = https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_API_BASE_URL=https://sandbox.asaas.com/api/v3
# Token que o Asaas envia no header asaas-access-token do webhook (defina o mesmo no painel Asaas)
ASAAS_WEBHOOK_TOKEN=
# Token que pet360/imob360/bela360/wayAR/criar usam para consultar /pay-api/entitlement
PAY_SERVICE_TOKEN=
# Emails com acesso ao painel admin de pagamentos (separados por virgula)
ADMIN_EMAILS=
